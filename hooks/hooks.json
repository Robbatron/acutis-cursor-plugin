{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/session-start.sh",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/pre-tool-use.sh",
        "matcher": "Write",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/before-shell.sh",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/after-shell.sh",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/verification-allow-tracker.sh",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/verification-allow-tracker.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./scripts/stop-hook.sh",
        "timeout": 60,
        "loop_limit": 10
      }
    ]
  }
}
