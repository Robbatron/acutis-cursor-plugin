{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/hook.cmd cursor session-start",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/hook.cmd cursor before-submit-prompt",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.cmd cursor pre-write",
        "timeout": 20,
        "failClosed": true,
        "matcher": "Write"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/hook.cmd cursor before-shell",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/hook.cmd cursor after-shell",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.cmd cursor record-allow",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/hook.cmd cursor record-allow",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./scripts/hook.cmd cursor stop",
        "timeout": 30,
        "loop_limit": 10
      }
    ]
  }
}
