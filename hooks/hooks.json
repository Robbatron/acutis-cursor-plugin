{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/hook.cmd cursor session-start",
        "timeout": 5
      },
      {
        "command": "./scripts/hook.cmd cursor flush-reports",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.cmd cursor pre-write",
        "timeout": 20,
        "failClosed": true,
        "matcher": "Write"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/hook.cmd cursor before-shell",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/hook.cmd cursor after-shell",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.cmd cursor record-allow",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/hook.cmd cursor record-allow",
        "timeout": 5
      },
      {
        "command": "./scripts/hook.cmd cursor after-mcp",
        "timeout": 20
      }
    ],
    "sessionEnd": [
      {
        "command": "./scripts/hook.cmd cursor session-end",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./scripts/hook.cmd cursor before-mcp",
        "timeout": 20
      }
    ]
  }
}
